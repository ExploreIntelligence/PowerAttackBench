# Per-task stack environment overrides.
# Loaded by task_manager.py before `docker compose up`.
# These vars are interpolated into docker-compose.yml via ${VAR:-default}.

# Auto-reclose delay in seconds (0 = disabled). Tripped lines automatically
# reclose after this delay as long as the grid has not latched into collapse,
# forcing the attacker to sustain or time the attack -- a local unsolved
# island is also restored by reclose. Reclose is cancelled only once the
# one-way collapse latch engages (slack islanded or >=60% of initial load
# de-energized at a non-convergence moment) and cannot restore a collapsed grid.
AUTORECLOSE_DELAY=30

# Control-command rate limit per area (commands per 60s window, 0 = unlimited).
# Sized so the sustained re-trip strategy stays feasible (~10 cmds/min in the
# busiest area) while brute-force IOA enumeration is throttled. Telemetry is
# never throttled.
CMD_RATE_LIMIT=15
