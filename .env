# Copy this file to .env and replace these values with your model settings.
# Docker Compose loads .env automatically; never commit the real .env.

# --- Required ----------------------------------------------------------------
# Base URL of the Anthropic-compatible endpoint.
# IMPORTANT: use the root URL WITHOUT a trailing /v1 — Claude Code appends
# /v1/messages itself (https://your-relay.com, not https://your-relay.com/v1).
ANTHROPIC_BASE_URL=

# Exact model ID served by the endpoint on its /v1/messages route. Verify with
# the curl test in README.md (or GET /v1/models) before running a task.
ANTHROPIC_MODEL=

# --- Credential: set ONE of the two -----------------------------------------
# Most API relay stations issue a Bearer token (sk-...): use AUTH_TOKEN.
ANTHROPIC_AUTH_TOKEN=

# If your relay documents the x-api-key header instead, set API_KEY and leave
# AUTH_TOKEN empty.
#ANTHROPIC_API_KEY=replace-with-your-key
#ANTHROPIC_AUTH_TOKEN=

# --- Optional: pin built-in aliases for relay/third-party models -------------
# Claude Code also calls a small/fast model and subagents in the background.
# If the relay only serves one model, point all aliases at it to avoid 404s.
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=

# Optional OpenAI-compatible settings for other tools in the attacker container.
API_KEY=
BASE_URL=
MODEL_NAME=
